---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Order confirmed — Transfer Chick">
  <div class="container-page py-16"><div id="state" class="mx-auto max-w-2xl text-center"><div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-black text-xl text-white">✓</div><h1 class="mt-6 font-display text-4xl font-bold">Order received. Nice choice.</h1><p class="mt-4 text-neutral-600">We’re checking the payment with Stripe and loading your receipt.</p></div><div id="order" class="mx-auto mt-10 hidden max-w-2xl rounded-2xl border border-neutral-200 bg-white p-6"></div></div>
  <script>
    const sessionId = new URLSearchParams(location.search).get('session_id'); const box=document.getElementById('order'); const state=document.getElementById('state');
    (async()=>{ if(!sessionId){ if(state) state.innerHTML='<h1 class="font-display text-4xl font-bold">Missing order session</h1>'; return; } try { const r=await fetch(`/api/order?session_id=${encodeURIComponent(sessionId)}`); const data=await r.json(); if(!r.ok) throw new Error(data.error); localStorage.removeItem('tcc-cart'); if(box){ box.innerHTML=`<div class="flex items-start justify-between gap-5"><div><div class="text-sm text-neutral-500">Confirmation</div><h2 class="mt-1 font-display text-2xl font-semibold">${data.order.customerEmail}</h2></div><div class="font-semibold">£${(data.order.total/100).toFixed(2)}</div></div><div class="mt-6 border-t border-neutral-200 pt-5"><div class="text-sm font-semibold">Items</div><div class="mt-3 grid gap-2">${data.items.map((i:any)=>`<div class="flex justify-between text-sm"><span>${i.name} · ${i.size} · ${i.color} × ${i.quantity}</span><span>£${(i.unitPrice*i.quantity/100).toFixed(2)}</span></div>`).join('')}</div></div><a class="btn-primary mt-7" href="/shop">Keep shopping</a>`; box.classList.remove('hidden'); } } catch(e:any){ if(state) state.innerHTML=`<h1 class="font-display text-4xl font-bold">We couldn’t verify the order yet.</h1><p class="mt-4 text-neutral-600">${e.message || 'Please check your email or contact us if you need help.'}</p>`; } })();
  </script>
</BaseLayout>
