---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProduct, getProducts } from '../../data/catalog';
export const prerender = false;
const slug = Astro.params.slug || '';
const product = await getProduct(slug, Astro.locals);
if (!product) return Astro.redirect('/404');
const related = (await getProducts(Astro.locals)).filter((p) => p.id !== product.id).slice(0,3);
const firstImage = product.images[0];
const imageUrl = firstImage?.r2Key?.startsWith('demo/') ? `/demo/${firstImage.r2Key.split('/').pop()}` : `/images/${firstImage?.r2Key}`;
const isToteBag = product.category === 'Tote Bags';
const availableSizes = [...new Set(product.variants.map((v) => v.size))];
---
<BaseLayout title={`${product.name} — Transferchic Clothing`} description={product.description}>
  <div class="container-page py-10 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <div class="overflow-hidden rounded-[2rem] border border-neutral-200 bg-neutral-100"><img id="product-image" src={imageUrl} alt={firstImage?.altText} class="aspect-square w-full cursor-zoom-in object-cover" /></div>
        <p class="mt-3 text-center text-xs text-neutral-400">Tap image to zoom</p>
      </div>
      <div class="lg:pt-6">
        <div class="pill inline-flex">{product.category}</div><h1 class="mt-4 font-display text-4xl font-bold">{product.name}</h1><div class="mt-4 text-xl font-semibold">£{product.basePrice.toFixed(2)}</div><p class="mt-5 max-w-xl leading-7 text-neutral-600">{product.description}</p>
        <div class="mt-8 grid gap-6">
          <label class="text-sm font-semibold">Color<select id="color" class="mt-2 w-full rounded-xl border border-neutral-300 bg-white p-3">{[...new Set(product.variants.map((v)=>v.color))].map((c)=><option>{c}</option>)}</select></label>
          <div><div class="text-sm font-semibold">Size</div><div id="sizes" class={`mt-2 grid gap-2 ${availableSizes.length === 1 ? 'grid-cols-1' : 'grid-cols-5'}`}>{availableSizes.map((s)=><button class={`rounded-xl border p-3 text-sm ${product.variants.some(v=>v.size===s && v.stockQuantity>0)?'border-neutral-300':'cursor-not-allowed border-neutral-100 text-neutral-300'}`} disabled={!product.variants.some(v=>v.size===s && v.stockQuantity>0)} data-size={s}>{s}</button>)}</div>{!isToteBag && <a href="/size-guide" class="mt-2 inline-block text-xs underline">View size guide</a>}</div>
          <div class="flex gap-3"><label class="text-sm font-semibold">Qty<input id="quantity" type="number" min="1" max="10" value="1" class="mt-2 w-24 rounded-xl border border-neutral-300 p-3" /></label><button id="add" class="btn-primary mt-6 flex-1">Add to cart</button></div>
          <div id="notice" class="hidden rounded-xl bg-neutral-100 p-3 text-sm"></div>
        </div>
        <div class="mt-10 border-t border-neutral-200 pt-7"><div class="font-semibold">Simple, useful details</div><ul class="mt-3 grid gap-2 text-sm text-neutral-600">{isToteBag ? <><li>• Everyday printed tote bag</li><li>• One size</li><li>• Guest checkout — no account required</li></> : <><li>• Soft everyday tee fit</li><li>• Machine washable</li><li>• Guest checkout — no account required</li></>}</ul></div>
      </div>
    </div>
  </div>
  <section class="container-page pb-16"><div class="flex items-end justify-between"><h2 class="font-display text-2xl font-bold">You might also like</h2><a href="/shop" class="text-sm underline">See all</a></div><div class="mt-6 grid gap-5 sm:grid-cols-3">{related.map((p)=><ProductCard product={p}/>)}</div></section>
  <div id="zoom" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-5"><button id="close-zoom" class="absolute right-5 top-5 rounded-full bg-white px-4 py-2 text-sm">Close</button><img src={imageUrl} alt={firstImage?.altText} class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain" /></div>
  <script define:vars={{ variants: product.variants, productId: product.id, productName: product.name, basePrice: product.basePrice, imageUrl }}>
    const color = document.getElementById('color') as HTMLSelectElement;
    const notice = document.getElementById('notice');
    const sizeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-size]')];
    let selectedSize = sizeButtons.find((b) => !b.disabled)?.dataset.size || '';
    sizeButtons.forEach((button) => button.addEventListener('click', () => { selectedSize = button.dataset.size || ''; sizeButtons.forEach((b) => b.classList.toggle('border-black', b === button)); }));
    document.getElementById('add')?.addEventListener('click', () => {
      const variant = variants.find((v) => v.size === selectedSize && v.color === color.value && v.stockQuantity > 0);
      if (!variant) { notice?.classList.remove('hidden'); if (notice) notice.textContent = 'That size/color is currently unavailable.'; return; }
      const quantity = Math.max(1, Math.min(10, Number((document.getElementById('quantity') as HTMLInputElement).value)));
      const cart = JSON.parse(localStorage.getItem('tcc-cart') || '[]');
      const existing = cart.find((i:any) => i.variantId === variant.id);
      if (existing) existing.quantity += quantity; else cart.push({ variantId: variant.id, productId, productName, size: variant.size, color: variant.color, quantity, unitPrice: basePrice, imageUrl });
      localStorage.setItem('tcc-cart', JSON.stringify(cart)); window.dispatchEvent(new Event('tcc-cart-updated')); if (notice) { notice.textContent = 'Added to your bag.'; notice.classList.remove('hidden'); }
    });
    const zoom = document.getElementById('zoom'); document.getElementById('product-image')?.addEventListener('click', () => zoom?.classList.replace('hidden','flex')); document.getElementById('close-zoom')?.addEventListener('click', () => zoom?.classList.replace('flex','hidden')); zoom?.addEventListener('click', (e) => { if (e.target === zoom) zoom.classList.replace('flex','hidden'); });
  </script>
</BaseLayout>
