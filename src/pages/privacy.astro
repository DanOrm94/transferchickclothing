import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy — Transfer Chick"><div class="container-page py-14"><article class="prose max-w-3xl"><div class="text-sm uppercase tracking-wider text-neutral-400 not-prose">Privacy</div><h1>Privacy policy</h1><p>We use the information needed to fulfil orders, provide support and operate the storefront. Checkout payment details are handled by Stripe rather than stored by this site.</p><h2>Information we process</h2><p>Order email, shipping information, order contents and operational records. Contact form messages are processed to respond to enquiries.</p><h2>Third parties</h2><p>Stripe handles hosted checkout and payment processing; Resend is used for transactional email; Cloudflare provides hosting, D1 and R2 infrastructure.</p><h2>Retention</h2><p>Keep only the records needed for fulfilment, accounting, fraud prevention and legal obligations. Replace this starter copy with your final privacy notice before launch.</p></article></div></BaseLayout>
