---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Transfer Chick"><div class="container-page py-14"><div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div><div class="text-sm uppercase tracking-wider text-neutral-400">Contact</div><h1 class="mt-3 font-display text-4xl font-bold">Need to ask us something?</h1><p class="mt-5 text-neutral-600">Questions about sizing, an order or a design? Send a message and we’ll get back to you.</p></div><form id="contact-form" class="grid gap-4 rounded-2xl border border-neutral-200 bg-white p-6"><label class="text-sm font-semibold">Name<input name="name" class="mt-2 w-full rounded-xl border border-neutral-300 p-3" /></label><label class="text-sm font-semibold">Email<input required type="email" name="email" class="mt-2 w-full rounded-xl border border-neutral-300 p-3" /></label><label class="text-sm font-semibold">Message<textarea required name="message" rows="6" class="mt-2 w-full rounded-xl border border-neutral-300 p-3"></textarea></label><div class="rounded-xl border border-dashed border-neutral-300 p-4 text-xs text-neutral-500">Turnstile placeholder: add the Cloudflare widget here with your production site key. The server endpoint verifies the returned token.</div><input type="hidden" name="turnstileToken" id="turnstile-token" /><button class="btn-primary" type="submit">Send message</button><p id="status" class="hidden text-sm"></p></form></div></div>
<script>
  const form = document.getElementById('contact-form') as HTMLFormElement; const status = document.getElementById('status');
  form?.addEventListener('submit', async (event) => { event.preventDefault(); const data = Object.fromEntries(new FormData(form)); if(!data.turnstileToken) data.turnstileToken='DEV_TOKEN_REPLACE_WITH_TURNSTILE'; const r = await fetch('/api/contact',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)}); const result=await r.json(); if(status){status.textContent=result.ok?'Message sent.':'Unable to send: '+(result.error||'Try again.');status.className=result.ok?'text-sm text-green-700':'text-sm text-red-600';} if(result.ok) form.reset(); });
</script>
</BaseLayout>
