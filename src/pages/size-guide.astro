---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Size guide — Transfer Chick"><div class="container-page py-14"><div class="max-w-2xl"><div class="text-sm uppercase tracking-wider text-neutral-400">Size guide</div><h1 class="mt-3 font-display text-4xl font-bold">A relaxed everyday fit.</h1><p class="mt-4 text-neutral-600">For the best fit, compare your favourite tee against the garment measurements below.</p></div><div class="mt-10 overflow-x-auto rounded-2xl border border-neutral-200 bg-white"><table class="w-full min-w-[620px] text-left text-sm"><thead class="border-b border-neutral-200 bg-neutral-50"><tr><th class="p-4">Size</th><th class="p-4">Chest (cm)</th><th class="p-4">Length (cm)</th><th class="p-4">Typical fit</th></tr></thead><tbody class="divide-y divide-neutral-100"><tr><td class="p-4 font-semibold">S</td><td class="p-4">50</td><td class="p-4">69</td><td class="p-4">Neat</td></tr><tr><td class="p-4 font-semibold">M</td><td class="p-4">53</td><td class="p-4">72</td><td class="p-4">Relaxed</td></tr><tr><td class="p-4 font-semibold">L</td><td class="p-4">56</td><td class="p-4">74</td><td class="p-4">Relaxed+</td></tr><tr><td class="p-4 font-semibold">XL</td><td class="p-4">60</td><td class="p-4">77</td><td class="p-4">Oversized</td></tr><tr><td class="p-4 font-semibold">2XL</td><td class="p-4">64</td><td class="p-4">79</td><td class="p-4">Oversized+</td></tr></tbody></table></div><p class="mt-4 text-xs text-neutral-500">Measurements are a starting point; production blanks can vary slightly between runs.</p></div></BaseLayout>
