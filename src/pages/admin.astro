---
import BaseLayout from '../layouts/BaseLayout.astro';
const cookie = Astro.request.headers.get('cookie') || '';
const loggedIn = cookie.includes('tcc_admin=1');
const orders = loggedIn ? await Astro.locals.runtime.env.DB.prepare('SELECT id, customer_email, status, total, created_at FROM orders ORDER BY created_at DESC LIMIT 100').all().then(r => r.results || []) : [];
---
<BaseLayout title="Admin — Transfer Chick"><div class="container-page py-12">{!loggedIn ? <form method="POST" action="/api/admin/login" class="mx-auto max-w-md rounded-2xl border border-neutral-200 bg-white p-6"><h1 class="font-display text-3xl font-bold">Admin</h1><p class="mt-2 text-sm text-neutral-500">Private order dashboard.</p><input name="password" type="password" placeholder="Password" required class="mt-6 w-full rounded-xl border border-neutral-300 p-3"/><button class="btn-primary mt-4 w-full">Sign in</button></form> : <div><div class="flex items-end justify-between"><div><div class="text-sm uppercase tracking-wider text-neutral-400">Admin</div><h1 class="mt-2 font-display text-4xl font-bold">Orders</h1></div><a href="/api/admin/logout" class="btn-secondary">Log out</a></div><div class="mt-8 overflow-x-auto rounded-2xl border border-neutral-200 bg-white"><table class="w-full min-w-[860px] text-left text-sm"><thead class="border-b border-neutral-200 bg-neutral-50"><tr><th class="p-4">Order</th><th class="p-4">Email</th><th class="p-4">Status</th><th class="p-4">Total</th><th class="p-4">Created</th><th class="p-4">Action</th></tr></thead><tbody class="divide-y divide-neutral-100">{orders.map((o:any)=><tr><td class="p-4 font-semibold">#{o.id}</td><td class="p-4">{o.customer_email}</td><td class="p-4"><span class="pill">{o.status}</span></td><td class="p-4">£{(Number(o.total)/100).toFixed(2)}</td><td class="p-4 text-neutral-500">{o.created_at}</td><td class="p-4"><button data-order={o.id} data-status={o.status === 'shipped' ? 'paid' : 'shipped'} class="text-sm underline">{o.status === 'shipped' ? 'Mark paid' : 'Mark shipped'}</button></td></tr>)}</tbody></table></div></div>}</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-order]').forEach((button) => button.addEventListener('click', async () => { const id=Number(button.dataset.order); const status=button.dataset.status; const r=await fetch('/api/admin/orders',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({id,status})}); if(r.ok) location.reload(); }));
</script>
</BaseLayout>
