---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../data/catalog';
const products = await getProducts(Astro.locals);
const category = Astro.url.searchParams.get('category') || 'All';
const size = Astro.url.searchParams.get('size') || 'All';
const color = Astro.url.searchParams.get('color') || 'All';
const max = Number(Astro.url.searchParams.get('max') || 1000);
const filtered = products.filter((p) => (category === 'All' || p.category === category) && p.basePrice <= max && (size === 'All' || p.variants.some((v) => v.size === size && v.stockQuantity > 0)) && (color === 'All' || p.variants.some((v) => v.color === color && v.stockQuantity > 0)));
const categories = ['All', ...new Set(products.map((p) => p.category))];
const colors = ['All', ...new Set(products.flatMap((p) => p.variants.map((v) => v.color)))];
---
<BaseLayout title="Shop tees — Transferchic Clothing">
  <div class="container-page py-12">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><div class="text-sm uppercase tracking-wider text-neutral-400">Transferchic Clothing</div><h1 class="mt-2 font-display text-4xl font-bold">All the odd little tees.</h1></div><div class="text-sm text-neutral-500">{filtered.length} designs</div></div>
    <form class="mt-8 grid gap-3 rounded-2xl border border-neutral-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-4" method="GET">
      <label class="text-sm">Category<select name="category" class="mt-2 w-full rounded-xl border border-neutral-300 bg-white p-3"><option>All</option>{categories.slice(1).map((c)=><option selected={c===category}>{c}</option>)}</select></label>
      <label class="text-sm">Size<select name="size" class="mt-2 w-full rounded-xl border border-neutral-300 bg-white p-3"><option>All</option>{['S','M','L','XL','2XL'].map((s)=><option selected={s===size}>{s}</option>)}</select></label>
      <label class="text-sm">Color<select name="color" class="mt-2 w-full rounded-xl border border-neutral-300 bg-white p-3"><option>All</option>{colors.slice(1).map((c)=><option selected={c===color}>{c}</option>)}</select></label>
      <label class="text-sm">Max price<select name="max" class="mt-2 w-full rounded-xl border border-neutral-300 bg-white p-3"><option value="1000">Any price</option><option value="28">£28</option><option value="30">£30</option></select></label>
      <button class="btn-primary sm:col-span-2 lg:col-span-4">Apply filters</button>
    </form>
    <div class="mt-10 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">{filtered.map((product) => <ProductCard product={product} />)}</div>
    {filtered.length === 0 && <div class="mt-12 rounded-2xl border border-dashed border-neutral-300 p-12 text-center text-neutral-600">Nothing matches those filters yet.</div>}
  </div>
</BaseLayout>
